# The game — never commit anything from the disc or made from the game's code
/disc/
/game/
/generated/
*.chd
*.iso
*.bin
*.elf
SLUS_*
*.p2s
# memory cards the runtime creates, pictures of the game
/mc0/
/mc1/
/shots/
# mods: animations and other content converted from games (yours, never committed)
/mods/

# developer-only scripts and notes (kept locally, never in the repository or a release)
/developer/
/CODEX_HANDOFF.md
/README_DRAFT.md
/goodbase_stubs.txt
/play_logged.bat
/build-diag.bat
/run_cutroster_test.bat
/run_legshake_*.bat
/run_nameplate_*.bat

# logs, runtime UI state, caches
/logs/
*.log
imgui.ini
# the player's settings (the game writes a default one)
settings.toml
# the settings program's build output
/settings-app/bin/
/settings-app/obj/
__pycache__/
*.pyc

# OS
Thumbs.db
.DS_Store
# release zips and local test packages
/dist/
