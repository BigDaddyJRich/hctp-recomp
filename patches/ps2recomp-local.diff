+                }
+            }
+        }
+        if (dump)
+            std::fclose(dump);
+        if (out.empty())
+            return "[pcprof] no samples (VENDETTA_HOSTPROF=2 samples the game thread's, the GS thread's and the chain worker's code addresses)\n";
+        return out;
+    }
