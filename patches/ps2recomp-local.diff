+    VU1_FORCEINLINE V intToFloat(V bits)
+    {
+        V out;
+        for (unsigned k = 0; k < 4u; ++k)
+        {
+            int32_t i;
+            std::memcpy(&i, &bits.f[k], 4);
+            out.f[k] = static_cast<float>(i);
+        }
+        return out;
+    }
+
+    VU1_FORCEINLINE V intToFloat(V bits, float divisor)
+    {
+        V out = intToFloat(bits);
