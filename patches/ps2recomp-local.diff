+    if (!vram || vramSize < GSMem::MEMORY_SIZE)
+        return {};
+    thread_local GSCpuBackend converter{1u};
+    converter.Initialize(const_cast<uint8_t *>(vram), vramSize);
+    return converter.PresentFromLocalMemory(request);
