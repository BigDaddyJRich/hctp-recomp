+    VU1_FORCEINLINE V rotate(V v) { return V{{v.f[1], v.f[2], v.f[3], v.f[0]}}; }
+    VU1_FORCEINLINE V splatBits(int32_t bits) { float f; std::memcpy(&f, &bits, 4); return splat(f); }
