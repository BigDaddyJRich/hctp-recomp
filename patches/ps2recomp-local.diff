+    for (const PageRange &target : m_queuedTargets)
+        if (target.overlaps(pages))
+        {
+            FlushQueueUnlocked(cause);
+            return;
+        }
+    for (const PageRange &read : m_queuedTextures)
+        if (read.overlaps(pages))
+        {
+            FlushQueueUnlocked(cause);
+            return;
+        }
+}
