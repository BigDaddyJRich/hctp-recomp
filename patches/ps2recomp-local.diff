+    VU1_FORCEINLINE V splatBits(int32_t bits) { return _mm_castsi128_ps(_mm_set1_epi32(bits)); }
+
+    template <unsigned Dest>
+    VU1_FORCEINLINE void store(float *p, V value)
+    {
+        if constexpr (Dest == 0xFu)
