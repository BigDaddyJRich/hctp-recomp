<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VendettaSettings.ViewModels"
             x:Class="VendettaSettings.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceItem" x:DataType="vm:Choice">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- one page per part (the page list picks it: TabIndex 0 Display, 1 Graphics, 2 Sound, 3 Controls); each is
         flat sections — a small capitals heading over a line, then rows: the label left, the control right -->
    <Panel>
        <!-- Display -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsDisplayTab}">
            <StackPanel Margin="26,22" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Classes="h1" Text="Display" />
                <StackPanel>
                    <TextBlock Classes="cap" Text="WINDOW" />
                    <Border Classes="capline" />
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Show the game in" />
                                <TextBlock Classes="hint" Text="{Binding ModeHint}" />
                            </StackPanel>
                            <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding ModeIndex}">
                                <ListBoxItem Content="Window" />
                                <ListBoxItem Content="Borderless" />
                                <ListBoxItem Content="Fullscreen" />
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <TextBlock Classes="label" Text="Screen" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Width="300" VerticalAlignment="Center"
                                      ItemsSource="{Binding ScreenChoices}" SelectedItem="{Binding Screen}"
                                      ItemTemplate="{StaticResource ChoiceItem}" />
                        </Grid>
                    </Border>
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Start maximised" />
                                <TextBlock Classes="hint" Text="{Binding MaximisedHint}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                          IsChecked="{Binding Maximised}" IsEnabled="{Binding IsWindowMode}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="cap" Text="FULLSCREEN" />
                    <Border Classes="capline" />
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Resolution" />
                                <TextBlock Classes="hint" Text="{Binding FullscreenHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="300" VerticalAlignment="Center"
                                      ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding Resolution}"
                                      ItemTemplate="{StaticResource ChoiceItem}" IsEnabled="{Binding IsFullscreen}" />
                        </Grid>
                    </Border>
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Refresh rate" />
                                <TextBlock Classes="hint" Text="{Binding RefreshHint}" />
                            </StackPanel>
                            <Panel Grid.Column="1" Width="300" VerticalAlignment="Center">
                                <ComboBox HorizontalAlignment="Stretch" IsVisible="{Binding IsFullscreen}"
                                          ItemsSource="{Binding RefreshChoices}" SelectedItem="{Binding Refresh}"
                                          ItemTemplate="{StaticResource ChoiceItem}" />
                                <Border IsVisible="{Binding IsNotFullscreen}" Height="30" CornerRadius="6"
                                        BorderBrush="{StaticResource VLine}" BorderThickness="1" Padding="10,0">
                                    <TextBlock Text="{Binding WindowsRate}" VerticalAlignment="Center" FontSize="13" Classes="muted" />
                                </Border>
                            </Panel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="cap" Text="PICTURE" />
                    <Border Classes="capline" />
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="VSync" />
                                <TextBlock Classes="hint" Text="{Binding VsyncHint}" />
                            </StackPanel>
                            <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding VsyncIndex}">
                                <ListBoxItem Content="Off" />
                                <ListBoxItem Content="On" />
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Picture shape" />
                                <TextBlock Classes="hint" Text="{Binding ShapeHint}" />
                            </StackPanel>
                            <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding ShapeIndex}">
                                <ListBoxItem Content="Widescreen" />
                                <ListBoxItem Content="4:3" />
                                <ListBoxItem Content="Stretched" />
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Graphics -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsGraphicsTab}">
            <StackPanel Margin="26,22" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Classes="h1" Text="Graphics" />
                <StackPanel>
                    <TextBlock Classes="cap" Text="DRAWING" />
                    <Border Classes="capline" />
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Drawn by" />
                                <TextBlock Classes="hint" Text="{Binding RendererHint}" />
                            </StackPanel>
                            <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding RendererIndex}">
                                <ListBoxItem Content="Graphics card" />
                                <ListBoxItem Content="CPU" />
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Scale" />
                                <TextBlock Classes="hint" Text="{Binding ScaleHint}" />
                            </StackPanel>
                            <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding ScaleIndex}">
                                <ListBoxItem Content="1×" />
                                <ListBoxItem Content="2×" />
                                <ListBoxItem Content="4×" />
                                <ListBoxItem Content="8×" />
                                <ListBoxItem Content="16×" />
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="cap" Text="SCALING TO THE WINDOW" />
                    <Border Classes="capline" />
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Filter" />
                                <TextBlock Classes="hint" Text="{Binding FilterHint}" />
                            </StackPanel>
                            <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding FilterIndex}">
                                <ListBoxItem Content="FSR" />
                                <ListBoxItem Content="Smooth" />
                                <ListBoxItem Content="Blocky" />
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Sharpening" />
                                <TextBlock Classes="hint" Text="How crisp edges look after scaling (with FSR)" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Slider Width="200" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Sharpening}" IsEnabled="{Binding SharpeningEnabled}" />
                                <TextBlock Width="42" TextAlignment="Right" VerticalAlignment="Center" Classes="mono muted"
                                           Text="{Binding SharpeningText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <TextBlock Classes="cap" Text="MODELS" />
                    <Border Classes="capline" />
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="High Poly in every match" />
                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                           Text="Full-detail wrestlers and arenas in 3- and 4-fighter matches too. Off = as on the PS2" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                          IsChecked="{Binding HighPoly}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Sound -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsSoundTab}">
            <StackPanel Margin="26,22" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Classes="h1" Text="Sound" />
                <StackPanel>
                    <TextBlock Classes="cap" Text="SOUND" />
                    <Border Classes="capline" />
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <TextBlock Classes="label" Text="Volume" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Slider Width="200" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Volume}" />
                                <TextBlock Width="42" TextAlignment="Right" VerticalAlignment="Center" Classes="mono muted"
                                           Text="{Binding VolumeText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Arena reverb" />
                                <TextBlock Classes="hint" Text="The echo the PS2's sound chip adds in matches" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                          IsChecked="{Binding Reverb}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Controls -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsControlsTab}">
            <StackPanel Margin="26,22" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Classes="h1" Text="Controls" />
                <StackPanel>
                    <TextBlock Classes="cap" Text="PLAYERS" />
                    <Border Classes="capline" />
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Up to 4 players" />
                                <TextBlock Classes="hint"
                                           Text="Each player has their own controller, as on a PS2 with a multitap in port 2. Off: 2 controllers." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                          IsChecked="{Binding Multitap}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="cap" Text="CONTROLLERS" />
                    <Border Classes="capline" />
                    <Border Classes="row" Padding="0,8">
                        <Grid ColumnDefinitions="110,*,90">
                            <TextBlock Classes="cap" Text="PLAYER" />
                            <TextBlock Grid.Column="1" Classes="cap" Text="CONTROLLER" />
                            <TextBlock Grid.Column="2" Classes="cap" Text="VIBRATION" />
                        </Grid>
                    </Border>
                    <Border Classes="row" Padding="0,6">
                        <Grid ColumnDefinitions="110,*,90">
                            <TextBlock Text="Player 1" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Classes="dot" Width="7" Height="7" Classes.warn="{Binding !Pad1In}" />
                                <TextBlock Text="{Binding Pad1}" FontSize="13" Classes.good="{Binding Pad1In}" Classes.muted="{Binding !Pad1In}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" IsChecked="{Binding Vibration1}" />
                        </Grid>
                    </Border>
                    <Border Classes="row" Padding="0,6">
                        <Grid ColumnDefinitions="110,*,90">
                            <TextBlock Text="Player 2" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Classes="dot" Width="7" Height="7" Classes.warn="{Binding !Pad2In}" />
                                <TextBlock Text="{Binding Pad2}" FontSize="13" Classes.good="{Binding Pad2In}" Classes.muted="{Binding !Pad2In}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" IsChecked="{Binding Vibration2}" />
                        </Grid>
                    </Border>
                    <Border Classes="row" Padding="0,6">
                        <Grid ColumnDefinitions="110,*,90">
                            <TextBlock Text="Player 3" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Classes="dot" Width="7" Height="7" Classes.warn="{Binding !Pad3In}" />
                                <TextBlock Text="{Binding Pad3}" FontSize="13" Classes.good="{Binding Pad3In}" Classes.muted="{Binding !Pad3In}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" IsChecked="{Binding Vibration3}" />
                        </Grid>
                    </Border>
                    <Border Classes="row" Padding="0,6">
                        <Grid ColumnDefinitions="110,*,90">
                            <TextBlock Text="Player 4" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Classes="dot" Width="7" Height="7" Classes.warn="{Binding !Pad4In}" />
                                <TextBlock Text="{Binding Pad4}" FontSize="13" Classes.good="{Binding Pad4In}" Classes.muted="{Binding !Pad4In}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" OnContent="" OffContent="" IsChecked="{Binding Vibration4}" />
                        </Grid>
                    </Border>
                    <TextBlock Classes="hint" Margin="0,10,0,0" LineHeight="18"
                               Text="Controllers are given out in the order Windows lists them; Xbox-style (XInput) ones are shown here. Vibration works with those; PlayStation controllers through Steam or DS4Windows. The game's own VIBRATION option (pause menu) still applies." />
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="cap" Text="KEYBOARD" />
                    <Border Classes="capline" />
                    <Border Classes="row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Keyboard plays as" />
                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                           Text="Together with that player's controller. Players 3 and 4 need Up to 4 players." />
                            </StackPanel>
                            <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding KeyboardIndex}">
                                <ListBoxItem Content="Player 1" />
                                <ListBoxItem Content="Player 2" />
                                <ListBoxItem Content="Player 3" />
                                <ListBoxItem Content="Player 4" />
                                <ListBoxItem Content="Nobody" />
                            </ListBox>
                        </Grid>
                    </Border>
                    <!-- the keys (ps2_pad.cpp); what each button does in a match is the game's -->
                    <Grid ColumnDefinitions="150,*,28,150,*" Margin="0,10,0,0"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
                        <TextBlock Classes="key" Text="Move" />
                        <TextBlock Grid.Column="1" Classes="mono" Text="Arrow keys · W A S D" />
                        <TextBlock Grid.Row="1" Classes="key" Text="✕ Grapple" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="X · Space" />
                        <TextBlock Grid.Row="2" Classes="key" Text="□ Strike" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="Z · Num 0" />
                        <TextBlock Grid.Row="3" Classes="key" Text="○ Run" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="C · Esc" />
                        <TextBlock Grid.Row="4" Classes="key" Text="△ Triangle" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="mono" Text="V · Num 1" />
                        <TextBlock Grid.Row="5" Classes="key" Text="Start" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Classes="mono" Text="Enter" />
                        <TextBlock Grid.Row="6" Classes="key" Text="Select" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Classes="mono" Text="Tab" />
                        <TextBlock Grid.Column="3" Classes="key" Text="L1 Dodge" />
                        <TextBlock Grid.Column="4" Classes="mono" Text="Q" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Classes="key" Text="R1 Block" />
                        <TextBlock Grid.Row="1" Grid.Column="4" Classes="mono" Text="E" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Classes="key" Text="L2" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Classes="mono" Text="Left Shift" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Classes="key" Text="R2" />
                        <TextBlock Grid.Row="3" Grid.Column="4" Classes="mono" Text="Right Shift" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Classes="key" Text="Taunt · Blazin'" />
                        <TextBlock Grid.Row="4" Grid.Column="4" Classes="mono" Text="I J K L (right stick)" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
