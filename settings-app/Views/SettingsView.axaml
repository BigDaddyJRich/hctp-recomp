<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VendettaSettings.ViewModels"
             x:Class="VendettaSettings.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceItem" x:DataType="vm:Choice">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="30,26">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Classes="h1" Text="SETTINGS" />
            <Button Grid.Column="1" Classes="outline" Content="Reset to defaults" VerticalAlignment="Bottom"
                    Command="{Binding ResetToDefaultsCommand}" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,10,0,0">
            <TextBlock Classes="hint" Text="{Binding Status}" Foreground="{StaticResource VGood}" />
            <TextBlock Classes="hint"
                       Text="Saved as you change them, in settings.toml next to the game, and used the next time it starts." />
        </StackPanel>

        <TabControl Classes="pages" SelectedIndex="{Binding TabIndex}" Padding="0,8,0,0">
            <!-- Display -->
            <TabItem Header="Display">
                <Border Classes="card" Padding="20,4">
                    <ScrollViewer>
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="Window" />
                                    <TextBlock Classes="hint" Text="{Binding ModeHint}" />
                                </StackPanel>
                                <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding ModeIndex}">
                                    <ListBoxItem Content="Window" />
                                    <ListBoxItem Content="Borderless" />
                                    <ListBoxItem Content="Fullscreen" />
                                </ListBox>
                            </Grid>
                            <Border Classes="sep" />
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock Classes="label" Text="Screen" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Width="340" VerticalAlignment="Center"
                                          ItemsSource="{Binding ScreenChoices}" SelectedItem="{Binding Screen}"
                                          ItemTemplate="{StaticResource ChoiceItem}" />
                            </Grid>
                            <Border Classes="sep" />
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="Start maximised" />
                                    <TextBlock Classes="hint" Text="{Binding MaximisedHint}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                              IsChecked="{Binding Maximised}" IsEnabled="{Binding IsWindowMode}" />
                            </Grid>
                            <Border Classes="sep" />
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="Fullscreen resolution" />
                                    <TextBlock Classes="hint" Text="{Binding FullscreenHint}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="340" VerticalAlignment="Center"
                                          ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding Resolution}"
                                          ItemTemplate="{StaticResource ChoiceItem}" IsEnabled="{Binding IsFullscreen}" />
                            </Grid>
                            <Border Classes="sep" />
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="Refresh rate" />
                                    <TextBlock Classes="hint" Text="{Binding RefreshHint}" />
                                </StackPanel>
                                <Panel Grid.Column="1" Width="340" VerticalAlignment="Center">
                                    <ComboBox HorizontalAlignment="Stretch" IsVisible="{Binding IsFullscreen}"
                                              ItemsSource="{Binding RefreshChoices}" SelectedItem="{Binding Refresh}"
                                              ItemTemplate="{StaticResource ChoiceItem}" />
                                    <Border IsVisible="{Binding IsNotFullscreen}" Height="34" CornerRadius="8"
                                            BorderBrush="#3a363f" BorderThickness="1" Padding="12,0">
                                        <TextBlock Text="{Binding WindowsRate}" VerticalAlignment="Center" FontSize="13" Classes="muted" />
                                    </Border>
                                </Panel>
                            </Grid>
                            <Border Classes="sep" />
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="VSync" />
                                    <TextBlock Classes="hint" Text="{Binding VsyncHint}" />
                                </StackPanel>
                                <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding VsyncIndex}">
                                    <ListBoxItem Content="Off" />
                                    <ListBoxItem Content="On" />
                                </ListBox>
                            </Grid>
                            <Border Classes="sep" />
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="Picture shape" />
                                    <TextBlock Classes="hint" Text="{Binding ShapeHint}" />
                                </StackPanel>
                                <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding ShapeIndex}">
                                    <ListBoxItem Content="4:3" />
                                    <ListBoxItem Content="Stretched" />
                                    <ListBoxItem Content="Widescreen · planned" IsEnabled="False" />
                                </ListBox>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Graphics -->
            <TabItem Header="Graphics">
                <Border Classes="card" Padding="20,4" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Drawn by" />
                                <TextBlock Classes="hint" Text="{Binding RendererHint}" />
                            </StackPanel>
                            <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding RendererIndex}">
                                <ListBoxItem Content="Graphics card" />
                                <ListBoxItem Content="CPU" />
                            </ListBox>
                        </Grid>
                        <Border Classes="sep" />
                        <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Scale" />
                                <TextBlock Classes="hint" Text="{Binding ScaleHint}" />
                            </StackPanel>
                            <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding ScaleIndex}">
                                <ListBoxItem Content="1×" />
                                <ListBoxItem Content="2×" />
                                <ListBoxItem Content="4×" />
                                <ListBoxItem Content="8×" />
                                <ListBoxItem Content="16×" />
                            </ListBox>
                        </Grid>
                        <Border Classes="sep" />
                        <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Scaling to the window" />
                                <TextBlock Classes="hint" Text="{Binding FilterHint}" />
                            </StackPanel>
                            <ListBox Grid.Column="1" Classes="seg" SelectedIndex="{Binding FilterIndex}">
                                <ListBoxItem Content="FSR" />
                                <ListBoxItem Content="Smooth" />
                                <ListBoxItem Content="Blocky" />
                            </ListBox>
                        </Grid>
                        <Border Classes="sep" />
                        <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Sharpening" />
                                <TextBlock Classes="hint" Text="How crisp edges look after scaling (with FSR)" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Slider Width="200" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Sharpening}" IsEnabled="{Binding SharpeningEnabled}" />
                                <TextBlock Width="42" TextAlignment="Right" VerticalAlignment="Center" Classes="mono muted"
                                           Text="{Binding SharpeningText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Sound -->
            <TabItem Header="Sound">
                <Border Classes="card" Padding="20,4" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <TextBlock Classes="label" Text="Volume" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Slider Width="200" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding Volume}" />
                                <TextBlock Width="42" TextAlignment="Right" VerticalAlignment="Center" Classes="mono muted"
                                           Text="{Binding VolumeText}" />
                            </StackPanel>
                        </Grid>
                        <Border Classes="sep" />
                        <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Arena reverb" />
                                <TextBlock Classes="hint" Text="The echo the PS2's sound chip adds in matches" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                          IsChecked="{Binding Reverb}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Controls: players 1-4, each with their own controller and vibration -->
            <TabItem Header="Controls">
                <StackPanel Spacing="12">
                    <Border Classes="card" Padding="20,4">
                        <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="label" Text="Up to 4 players" FontWeight="SemiBold" />
                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                           Text="Each player has their own controller, as on a PS2 with a multitap in port 2. Off: 2 controllers." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                          IsChecked="{Binding Multitap}" />
                        </Grid>
                    </Border>
                    <Border Classes="card" Padding="20,4">
                        <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="Player 1" FontWeight="SemiBold" />
                                    <TextBlock Classes="hint" Text="The first controller, or the keyboard" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Classes="hint" Text="Vibration" VerticalAlignment="Center" />
                                    <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding Vibration1}" />
                                </StackPanel>
                            </Grid>
                            <Border Classes="sep" />
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="Player 2" FontWeight="SemiBold" />
                                    <TextBlock Classes="hint" Text="The second controller" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Classes="hint" Text="Vibration" VerticalAlignment="Center" />
                                    <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding Vibration2}" />
                                </StackPanel>
                            </Grid>
                            <Border Classes="sep" />
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="Player 3" FontWeight="SemiBold" />
                                    <TextBlock Classes="hint" Text="The third controller (with up to 4 players)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Classes="hint" Text="Vibration" VerticalAlignment="Center" />
                                    <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding Vibration3}" />
                                </StackPanel>
                            </Grid>
                            <Border Classes="sep" />
                            <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="Player 4" FontWeight="SemiBold" />
                                    <TextBlock Classes="hint" Text="The fourth controller (with up to 4 players)" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Classes="hint" Text="Vibration" VerticalAlignment="Center" />
                                    <ToggleSwitch OnContent="" OffContent="" IsChecked="{Binding Vibration4}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Controllers are given out in the order Windows lists them. Vibration works with Xbox-style (XInput) controllers; PlayStation controllers through Steam or DS4Windows. The game's own VIBRATION option (pause menu) still applies. Changing buttons: coming." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
