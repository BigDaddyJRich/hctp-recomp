<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HctpSettings.ViewModels"
             x:Class="HctpSettings.Views.PlayView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22" Spacing="18">
            <Border CornerRadius="8" ClipToBounds="True" Background="#000000">
                <Image Source="/Assets/background.jpg" Stretch="Uniform" MaxHeight="300" />
            </Border>
            <TextBlock Classes="h1" Text="Play" />

            <!-- a newer version on GitHub -->
            <Border BorderBrush="{StaticResource VAccent}" BorderThickness="1" CornerRadius="8" Padding="18,16" Background="#1f2530"
                    IsVisible="{Binding Updates.ShowNotice}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Updates.NoticeTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#ffffff" />
                        <ItemsControl ItemsSource="{Binding Updates.NoticePoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnDefinitions="16,*" Margin="0,1">
                                        <TextBlock Classes="muted" FontSize="13" Text="•" />
                                        <TextBlock Grid.Column="1" FontSize="13" Foreground="{StaticResource VText2}" TextWrapping="Wrap" Text="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="hint" Text="{Binding Updates.NoticeMore}" IsVisible="{Binding Updates.NoticeMore, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="hint" Text="{Binding Updates.NoticeSize}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" MinWidth="170">
                        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Update now"
                                Command="{Binding Updates.UpdateNowCommand}" />
                        <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="What's new"
                                Command="{Binding Updates.ShowNotesCommand}" />
                        <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Later"
                                Background="Transparent" BorderThickness="0" Command="{Binding Updates.LaterOnCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
                <StackPanel>
                    <TextBlock Classes="cap" Text="YOUR GAME" />
                    <Border Classes="capline" Margin="0,8,0,8" />
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Classes="key" Text="Game" />
                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding DiscTitle}" />
                        <TextBlock Grid.Row="1" Classes="key" Text="Serial" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="mono" Text="SLUS-20787" VerticalAlignment="Center" />
                            <Border Classes="tag good" IsVisible="{Binding HasGame}"><TextBlock Text="✓ checked" /></Border>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Classes="key" Text="Save data" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding SaveLine}" />
                        <TextBlock Grid.Row="3" Classes="key" Text="Content Pack" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="{Binding ContentPackLine}" />
                        <TextBlock Grid.Row="4" Classes="key" Text="Commentary Pack" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="mono" Text="{Binding CommentaryPackLine}" />
                        <Button Grid.Row="5" Grid.Column="1" Classes="outline" Content="Get the packs on Discord"
                                IsVisible="{Binding PacksMissing}" Command="{Binding OpenPacksCommand}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Classes="cap" Text="HOW IT WILL OPEN" />
                    <Border Classes="capline" Margin="0,8,0,8" />
                    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Classes="key" Text="Window" />
                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Settings.SummaryWindow}" />
                        <TextBlock Grid.Row="1" Classes="key" Text="Picture" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding Settings.SummaryPicture}" />
                        <TextBlock Grid.Row="2" Classes="key" Text="Players" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding Settings.SummaryPlayers}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
