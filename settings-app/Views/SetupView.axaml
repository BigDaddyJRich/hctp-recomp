<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VendettaSettings.ViewModels"
             x:Class="VendettaSettings.Views.SetupView"
             x:DataType="vm:SetupViewModel">
    <!-- the first launch: the page (the setup's steps are in the page list's place, MainWindow) -->
    <Panel>
        <!-- 1: your disc -->
        <DockPanel Margin="26,22" IsVisible="{Binding IsDiscPage}" Width="760" HorizontalAlignment="Left">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,20">
                <TextBlock Classes="h1" Text="Choose your disc" />
                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                           Text="Your own copy of Def Jam Vendetta for PlayStation 2, the USA version (SLUS-20639), as an .iso or .chd file." />
            </StackPanel>
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <Button Grid.Column="1" Classes="accent" Content="Next: build the game" Command="{Binding BuildCommand}"
                        IsEnabled="{Binding CanBuild}" />
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20">
                    <StackPanel>
                        <TextBlock Classes="cap" Text="YOUR DISC" />
                        <Border Classes="capline" Margin="0,8,0,12" />
                        <Panel x:Name="DropZone" DragDrop.AllowDrop="True" Background="Transparent">
                            <Rectangle Stroke="{StaticResource VLine}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="8" RadiusY="8" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="16,12">
                                <PathIcon Width="24" Height="24" Foreground="{StaticResource VMuted}"
                                          Data="F1 M12,2 A10,10 0 1 1 11.99,2 Z M12,9 A3,3 0 1 0 12.01,9 Z" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource VText2}"
                                           Text="Drop the disc file here" />
                                <Button Grid.Column="2" Classes="outline" Content="Browse…" Click="OnBrowse" />
                            </Grid>
                        </Panel>

                        <TextBlock Classes="hint" Text="Checking the disc…" IsVisible="{Binding Checking}" Margin="0,12,0,0" />

                        <Border Background="{StaticResource VGoodBg}" BorderBrush="{StaticResource VGoodLine}" BorderThickness="1"
                                CornerRadius="8" Padding="16,12" Margin="0,12,0,0" IsVisible="{Binding ShowDiscOk}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="✓ Def Jam Vendetta found" FontWeight="SemiBold" Classes="good" VerticalAlignment="Center" />
                                    <Border Classes="tag good"><TextBlock Text="SLUS-20639" /></Border>
                                </StackPanel>
                                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                                    <TextBlock Foreground="{StaticResource VGoodLabel}" FontSize="13" Text="Console" />
                                    <TextBlock Grid.Column="1" Classes="mono" Text="PlayStation 2" />
                                    <TextBlock Grid.Row="1" Foreground="{StaticResource VGoodLabel}" FontSize="13" Text="Region" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="USA (NTSC-U)" />
                                    <TextBlock Grid.Row="2" Foreground="{StaticResource VGoodLabel}" FontSize="13" Text="File" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding DiscPath}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource VBadBg}" BorderBrush="{StaticResource VBadLine}" BorderThickness="1"
                                CornerRadius="8" Padding="16,12" Margin="0,12,0,0" IsVisible="{Binding ShowDiscBad}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="That's not the disc this needs" FontWeight="SemiBold" Classes="bad" />
                                <TextBlock FontSize="13" Foreground="{StaticResource VBadText}" TextWrapping="Wrap" Text="{Binding DiscProblem}" />
                                <TextBlock Classes="mono" Foreground="{StaticResource VBadText}" TextWrapping="Wrap" Text="{Binding DiscPath}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource VGoodBg}" BorderBrush="{StaticResource VGoodLine}" BorderThickness="1"
                                CornerRadius="8" Padding="16,12" Margin="0,12,0,0" IsVisible="{Binding DiscAlreadyRead}">
                            <TextBlock Classes="good" FontSize="13.5" TextWrapping="Wrap"
                                       Text="✓ Your disc was already read in an earlier try: Next carries on from there (or choose the disc again)." />
                        </Border>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="cap" Text="WHERE IT GOES" />
                        <Border Classes="capline" Margin="0,8,0,8" />
                        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="7">
                            <TextBlock Classes="key" Text="Folder" />
                            <TextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding FolderPath}" />
                            <TextBlock Grid.Row="1" Classes="key" Text="Space" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" FontSize="13" Text="{Binding SpaceText}" />
                        </Grid>
                        <TextBlock Classes="hint" Margin="0,8,0,0"
                                   Text="Want it somewhere else? Close this, move the folder, open it again." />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="cap" Text="WHEN IT'S BUILT" />
                        <Border Classes="capline" />
                        <Border Classes="row" BorderThickness="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="label" Text="Shortcuts to the game" />
                                    <TextBlock Classes="hint"
                                               Text="On your desktop and in this folder: &quot;Def Jam Vendetta Recompiled&quot; starts the game straight away." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                              IsChecked="{Binding MakeShortcuts}" />
                            </Grid>
                        </Border>
                        <TextBlock Classes="hint" Margin="0,10,0,0" LineHeight="18" TextWrapping="Wrap"
                                   Text="No game files come with this download. The game is built here, from your own copy, and never leaves your PC." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- 2: building -->
        <DockPanel Margin="26,22" IsVisible="{Binding IsBuildPage}" Width="760" HorizontalAlignment="Left">
            <TextBlock DockPanel.Dock="Top" Classes="h1" Text="{Binding Title}" Margin="0,0,0,20" />
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                <Button Classes="outline" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding Building}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasError}">
                    <Button Classes="outline" Content="Back" Command="{Binding BackCommand}" />
                    <Button Classes="outline" Content="Open the log" Command="{Binding OpenLogCommand}" />
                </StackPanel>
                <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Classes="good" FontSize="13" VerticalAlignment="Center"
                           Text="{Binding LastLine}" IsVisible="{Binding Done}" />
                <Button Grid.Column="2" Classes="accent" Content="Try again" Command="{Binding TryAgainCommand}"
                        IsVisible="{Binding HasError}" />
                <Button Grid.Column="2" Classes="accent" Content="Continue: your settings" Command="{Binding ContinueCommand}"
                        IsEnabled="{Binding Done}" IsVisible="{Binding !HasError}" />
            </Grid>
            <StackPanel Spacing="20">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding PercentText}" FontWeight="SemiBold" FontSize="13.5" />
                        <TextBlock Grid.Column="1" Classes="muted" FontSize="13.5" Text="{Binding TimeLine}" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Percent}" Height="8" CornerRadius="4"
                                 Classes.done="{Binding Done}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="cap" Text="STEPS" />
                    <Border Classes="capline" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SetupStep">
                                <Border Classes="steprow" Classes.now="{Binding IsNow}" Height="38" Padding="10,0" Margin="-10,0">
                                    <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                        <TextBlock FontWeight="Bold" Text="{Binding Mark}"
                                                   Classes.good="{Binding IsDone}" Classes.warn="{Binding IsNow}"
                                                   Classes.muted="{Binding IsNext}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Classes.strong="{Binding IsNow}"
                                                   Classes.muted="{Binding IsNext}" />
                                        <TextBlock Grid.Column="2" Classes="hint" Text="{Binding Note}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="mono muted" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                               Text="{Binding LastLine}" IsVisible="{Binding !Done}" />
                </StackPanel>

                <Border Background="{StaticResource VBadBg}" BorderBrush="{StaticResource VBadLine}" BorderThickness="1"
                        CornerRadius="8" Padding="16,12" IsVisible="{Binding HasError}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="What went wrong" FontWeight="SemiBold" Classes="bad" />
                        <TextBlock FontSize="13" Foreground="{StaticResource VBadText}" TextWrapping="Wrap" Text="{Binding Error}" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding LogPath, StringFormat='Everything it printed: {0}'}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Panel>
</UserControl>
