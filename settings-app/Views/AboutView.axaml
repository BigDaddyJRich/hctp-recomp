<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VendettaSettings.ViewModels"
             x:Class="VendettaSettings.Views.AboutView"
             x:DataType="vm:MainViewModel">
    <!-- flat sections, one label column (150) in every one so their rows line up -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22" Spacing="20">
            <TextBlock Classes="h1" Text="About" />

            <StackPanel>
                <TextBlock Classes="cap" Text="PROGRAM" />
                <Border Classes="capline" Margin="0,8,0,8" />
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Classes="key" Text="Name" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="mono" Text="Def Jam Vendetta Recompiled" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Classes="key" Text="Version" VerticalAlignment="Center" />
                    <Border Grid.Row="1" Grid.Column="1" Classes="tag" HorizontalAlignment="Left"><TextBlock Text="{Binding Version}" /></Border>
                    <TextBlock Grid.Row="2" Classes="key" Text="Made by" VerticalAlignment="Center" />
                    <Button Grid.Row="2" Grid.Column="1" Classes="outline" Command="{Binding OpenXCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="12" Height="12" Data="M2,2 H7 L22,22 H17 Z M19.5,2 H22 L4.5,22 H2 Z" />
                            <TextBlock Text="@jcsix on X" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel>
                <TextBlock Classes="cap" Text="YOUR INSTALL" />
                <Border Classes="capline" Margin="0,8,0,8" />
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Classes="key" Text="Built from" />
                    <TextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap"
                               Text="{Binding DiscTitle, StringFormat='{}{0} · SLUS-20639'}" />
                    <TextBlock Grid.Row="1" Classes="key" Text="The game" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding GameExeName}" />
                    <TextBlock Grid.Row="2" Classes="key" Text="Folder" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding FolderPath}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="150,12,0,0">
                    <Button Classes="outline" Content="Open game folder" Command="{Binding OpenFolderCommand}" />
                    <Button Classes="outline" Content="Open save data" Command="{Binding OpenSavesCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <TextBlock Classes="cap" Text="MADE WITH" />
                <Border Classes="capline" Margin="0,8,0,8" />
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="PS2Recomp" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="13.5" TextWrapping="Wrap"
                               Text="by ran-j: turns the PS2 game's code into C++ (GPL)" />
                    <TextBlock Grid.Row="1" FontSize="13.5" FontWeight="SemiBold" Text="paraLLEl-GS" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" FontSize="13.5" TextWrapping="Wrap"
                               Text="by Arntzen Software: the PS2's graphics chip on your graphics card (LGPL)" />
                    <TextBlock Grid.Row="2" FontSize="13.5" FontWeight="SemiBold" Text="adjmk" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" FontSize="13.5" TextWrapping="Wrap"
                               Text="the Def Jam mod kit: its map of the game's files and code" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="150,12,0,0">
                    <Button Classes="outline" Content="Licence (GPL-3.0)" Command="{Binding OpenLicenceCommand}" />
                    <Button Classes="outline" Content="Third-party notices" Command="{Binding OpenNoticesCommand}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Classes="hint" LineHeight="18"
                       Text="Free software under the GNU GPL version 3. Not made by or affiliated with Electronic Arts or Def Jam. No game files come with this program: the game is built on your PC from your own disc." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
