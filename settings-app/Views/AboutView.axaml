<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VendettaSettings.ViewModels"
             x:Class="VendettaSettings.Views.AboutView"
             x:DataType="vm:MainViewModel">
    <!-- flat sections, one label column (150) in every one so their rows line up -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22" Spacing="20">
            <TextBlock Classes="h1" Text="About" />

            <StackPanel>
                <TextBlock Classes="cap" Text="PROGRAM" />
                <Border Classes="capline" Margin="0,8,0,8" />
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Classes="key" Text="Name" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="mono" Text="Def Jam Vendetta Recompiled" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Classes="key" Text="Version" VerticalAlignment="Center" />
                    <Border Grid.Row="1" Grid.Column="1" Classes="tag" HorizontalAlignment="Left"><TextBlock Text="{Binding Version}" /></Border>
                    <TextBlock Grid.Row="2" Classes="key" Text="Made by" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="outline" Command="{Binding OpenXCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="12" Height="12" Data="M2,2 H7 L22,22 H17 Z M19.5,2 H22 L4.5,22 H2 Z" />
                                <TextBlock Text="@jcsix on X" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button Classes="outline" Command="{Binding OpenGitHubCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="13" Height="13" Data="M12,0.5 C5.65,0.5 0.5,5.65 0.5,12 C0.5,17.08 3.79,21.39 8.36,22.92 C8.94,23.02 9.15,22.67 9.15,22.36 L9.15,20.36 C5.95,21.06 5.27,18.99 5.27,18.99 C4.75,17.66 3.99,17.3 3.99,17.3 C2.94,16.58 4.07,16.6 4.07,16.6 C5.23,16.68 5.84,17.79 5.84,17.79 C6.87,19.56 8.54,19.05 9.2,18.75 C9.3,18 9.6,17.49 9.93,17.2 C7.38,16.91 4.69,15.92 4.69,11.52 C4.69,10.26 5.14,9.24 5.88,8.43 C5.76,8.14 5.36,6.97 5.99,5.38 C5.99,5.38 6.96,5.07 9.16,6.56 C10.08,6.3 11.07,6.18 12.05,6.18 C13.03,6.18 14.02,6.3 14.94,6.56 C17.14,5.07 18.11,5.38 18.11,5.38 C18.74,6.97 18.34,8.14 18.22,8.43 C18.96,9.24 19.41,10.26 19.41,11.52 C19.41,15.93 16.72,16.9 14.16,17.19 C14.57,17.55 14.94,18.25 14.94,19.33 L14.94,22.5 C14.94,22.81 15.15,23.17 15.74,23.06 C20.31,21.38 23.5,17.07 23.5,12 C23.5,5.65 18.35,0.5 12,0.5 Z" />
                                <TextBlock Text="jcsix694 on GitHub" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel>
                <TextBlock Classes="cap" Text="UPDATES" />
                <Border Classes="capline" />
                <Border Classes="row">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="label" Text="{Binding Updates.CurrentVersion, StringFormat='Version {0}'}" />
                            <TextBlock Classes="hint" Text="{Binding Updates.CheckText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="outline" VerticalAlignment="Center" Content="{Binding Updates.CheckButton}"
                                Command="{Binding Updates.CheckNowCommand}" IsEnabled="{Binding Updates.CanCheck}" />
                    </Grid>
                </Border>
                <Border Classes="row">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="label" Text="Check when this program opens" />
                            <TextBlock Classes="hint"
                                       Text="Asks GitHub for the newest version. Nothing else is sent, and nothing installs until you press Update." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center"
                                      IsChecked="{Binding Settings.CheckUpdates}" />
                    </Grid>
                </Border>
                <Border Classes="row">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="label" Text="Release notes" />
                            <TextBlock Classes="hint" Text="What changed in each version" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="outline" Content="This version's notes" Command="{Binding Updates.OpenThisVersionCommand}" />
                            <Button Classes="outline" Content="All versions" Command="{Binding Updates.OpenAllVersionsCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel>
                <TextBlock Classes="cap" Text="YOUR INSTALL" />
                <Border Classes="capline" Margin="0,8,0,8" />
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Classes="key" Text="Built from" />
                    <TextBlock Grid.Column="1" Classes="mono" TextWrapping="Wrap"
                               Text="{Binding DiscTitle, StringFormat='{}{0} · SLUS-20639'}" />
                    <TextBlock Grid.Row="1" Classes="key" Text="The game" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding GameExeName}" />
                    <TextBlock Grid.Row="2" Classes="key" Text="Folder" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="mono" TextWrapping="Wrap" Text="{Binding FolderPath}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="150,12,0,0">
                    <Button Classes="outline" Content="Open game folder" Command="{Binding OpenFolderCommand}" />
                    <Button Classes="outline" Content="Open save data" Command="{Binding OpenSavesCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <TextBlock Classes="cap" Text="MADE WITH" />
                <Border Classes="capline" Margin="0,8,0,8" />
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="PS2Recomp" />
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="13.5" TextWrapping="Wrap"
                               Text="by ran-j: turns the PS2 game's code into C++ (GPL)" />
                    <TextBlock Grid.Row="1" FontSize="13.5" FontWeight="SemiBold" Text="paraLLEl-GS" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" FontSize="13.5" TextWrapping="Wrap"
                               Text="by Arntzen Software: the PS2's graphics chip on your graphics card (LGPL)" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="150,12,0,0">
                    <Button Classes="outline" Content="Licence (GPL-3.0)" Command="{Binding OpenLicenceCommand}" />
                    <Button Classes="outline" Content="Third-party notices" Command="{Binding OpenNoticesCommand}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Classes="hint" LineHeight="18"
                       Text="Free software under the GNU GPL version 3. Not made by or affiliated with Electronic Arts or Def Jam. No game files come with this program: the game is built on your PC from your own disc." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
