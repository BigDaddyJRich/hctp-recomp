<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VendettaSettings.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- the accent (toggles, sliders, the selected choice): the launcher's red -->
        <Color x:Key="SystemAccentColor">#e0243c</Color>
        <Color x:Key="SystemAccentColorDark1">#c71f35</Color>
        <Color x:Key="SystemAccentColorDark2">#ad1b2e</Color>
        <Color x:Key="SystemAccentColorDark3">#931727</Color>
        <Color x:Key="SystemAccentColorLight1">#e8475b</Color>
        <Color x:Key="SystemAccentColorLight2">#ef6b7b</Color>
        <Color x:Key="SystemAccentColorLight3">#f5909c</Color>

        <SolidColorBrush x:Key="VBg" Color="#121114" />
        <SolidColorBrush x:Key="VNav" Color="#0c0b0e" />
        <SolidColorBrush x:Key="VPanel" Color="#1b1a1e" />
        <SolidColorBrush x:Key="VPanel2" Color="#26232a" />
        <SolidColorBrush x:Key="VLine" Color="#2f2c33" />
        <SolidColorBrush x:Key="VRowLine" Color="#26232a" />
        <SolidColorBrush x:Key="VText" Color="#f1eff2" />
        <SolidColorBrush x:Key="VMuted" Color="#a7a2ad" />
        <SolidColorBrush x:Key="VHint" Color="#8f8a96" />
        <SolidColorBrush x:Key="VAccent" Color="#e0243c" />
        <SolidColorBrush x:Key="VGood" Color="#6fd39a" />
        <SolidColorBrush x:Key="VBad" Color="#ff6b7e" />
        <SolidColorBrush x:Key="VWarn" Color="#f2c766" />
        <SolidColorBrush x:Key="VWarnBg" Color="#1f1b12" />
        <SolidColorBrush x:Key="VWarnLine" Color="#4a3d1c" />
        <FontFamily x:Key="VMono">Consolas</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource VBg}" />
            <Setter Property="Foreground" Value="{StaticResource VText}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource VText}" />
        </Style>

        <!-- text -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="36" />
        </Style>
        <Style Selector="TextBlock.cap">
            <Setter Property="FontFamily" Value="{StaticResource VMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="Foreground" Value="{StaticResource VMuted}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14.5" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource VHint}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource VMuted}" />
        </Style>
        <Style Selector="TextBlock.good">
            <Setter Property="Foreground" Value="{StaticResource VGood}" />
        </Style>
        <Style Selector="TextBlock.bad">
            <Setter Property="Foreground" Value="{StaticResource VBad}" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource VMono}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <!-- cards and setting rows -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource VPanel}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="Grid.row">
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style Selector="Border.sep">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource VRowLine}" />
        </Style>

        <!-- the side menu -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource VMuted}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.nav TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{StaticResource VPanel2}" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1d1b20" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VPanel2}" />
        </Style>

        <!-- buttons -->
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#4a4650" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.play">
            <Setter Property="Background" Value="{StaticResource VAccent}" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="44,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#ef3a50" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.play:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2a272f" />
            <Setter Property="Foreground" Value="#6b6672" />
        </Style>

        <!-- a choice of a few: a ListBox laid out in a row, the selected one in red -->
        <Style Selector="ListBox.seg">
            <Setter Property="Background" Value="{StaticResource VNav}" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.seg ListBoxItem">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#cfcad4" />
        </Style>
        <Style Selector="ListBox.seg ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox.seg ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VAccent}" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="ListBox.seg ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#ef3a50" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="ListBox.seg ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VAccent}" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="ListBox.seg ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#6b6672" />
        </Style>

        <!-- the settings tabs -->
        <Style Selector="TabControl.pages TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource VNav}" />
            <Setter Property="BorderBrush" Value="#3a363f" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <!-- the first-run setup -->
        <Style Selector="Border.stepnow, Border.stepdone, Border.stepnext">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.stepnow"><Setter Property="Background" Value="{StaticResource VAccent}" /></Style>
        <Style Selector="Border.stepdone"><Setter Property="Background" Value="#23573a" /></Style>
        <Style Selector="Border.stepnext">
            <Setter Property="BorderBrush" Value="#3a363f" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.stepnow TextBlock, Border.stepdone TextBlock, Border.stepnext TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Border.stepdone TextBlock"><Setter Property="Foreground" Value="{StaticResource VGood}" /></Style>
        <Style Selector="Border.stepnext TextBlock"><Setter Property="Foreground" Value="{StaticResource VMuted}" /></Style>
        <Style Selector="Border.steprow.now"><Setter Property="Background" Value="{StaticResource VPanel}" /></Style>
        <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{StaticResource VWarn}" /></Style>
        <Style Selector="TextBlock.strong">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource VAccent}" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="26,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#ef3a50" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2a272f" />
            <Setter Property="Foreground" Value="#6b6672" />
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource VAccent}" />
            <Setter Property="Background" Value="#2a272f" />
        </Style>
        <Style Selector="ProgressBar.done"><Setter Property="Foreground" Value="#4cc38a" /></Style>
    </Application.Styles>
</Application>
