<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VendettaSettings.App"
             RequestedThemeVariant="Dark">

    <!-- adjmk's look (its palette, type sizes and flat sections), so the two programs feel like one family -->
    <Application.Resources>
        <!-- the accent (toggles, sliders, the main buttons): adjmk's blue -->
        <Color x:Key="SystemAccentColor">#4f9cff</Color>
        <Color x:Key="SystemAccentColorDark1">#3f88e8</Color>
        <Color x:Key="SystemAccentColorDark2">#3275cf</Color>
        <Color x:Key="SystemAccentColorDark3">#2862b5</Color>
        <Color x:Key="SystemAccentColorLight1">#6aacff</Color>
        <Color x:Key="SystemAccentColorLight2">#86bcff</Color>
        <Color x:Key="SystemAccentColorLight3">#a3ccff</Color>

        <SolidColorBrush x:Key="VBg" Color="#1a1a1c" />
        <SolidColorBrush x:Key="VChrome" Color="#161618" />
        <SolidColorBrush x:Key="VNav" Color="#232326" />
        <SolidColorBrush x:Key="VPanel" Color="#232326" />
        <SolidColorBrush x:Key="VPanel2" Color="#2b2b30" />
        <SolidColorBrush x:Key="VLine" Color="#3a3a40" />
        <SolidColorBrush x:Key="VRowLine" Color="#2b2b30" />
        <SolidColorBrush x:Key="VText" Color="#e4e4e7" />
        <SolidColorBrush x:Key="VText2" Color="#c8c8ce" />
        <SolidColorBrush x:Key="VMuted" Color="#9a9aa2" />
        <SolidColorBrush x:Key="VHint" Color="#9a9aa2" />
        <SolidColorBrush x:Key="VDisabled" Color="#5a5a62" />
        <SolidColorBrush x:Key="VAccent" Color="#4f9cff" />
        <SolidColorBrush x:Key="VAccentDim" Color="#2b4d7a" />
        <SolidColorBrush x:Key="VGood" Color="#4ec98a" />
        <SolidColorBrush x:Key="VGoodBg" Color="#1c2a23" />
        <SolidColorBrush x:Key="VGoodLine" Color="#2f5c45" />
        <SolidColorBrush x:Key="VGoodLabel" Color="#9fc4b1" />
        <SolidColorBrush x:Key="VWarn" Color="#e0a83c" />
        <SolidColorBrush x:Key="VBad" Color="#e5533c" />
        <SolidColorBrush x:Key="VBadBg" Color="#453132" />
        <SolidColorBrush x:Key="VBadLine" Color="#93473e" />
        <SolidColorBrush x:Key="VBadText" Color="#eab9ae" />
        <FontFamily x:Key="VMono">Cascadia Mono, Consolas</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource VBg}" />
            <Setter Property="Foreground" Value="{StaticResource VText}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource VText}" />
        </Style>

        <!-- text -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <!-- a section's heading: small capitals over a thin line (Border.capline) -->
        <Style Selector="TextBlock.cap">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="LetterSpacing" Value="0.9" />
            <Setter Property="Foreground" Value="{StaticResource VMuted}" />
        </Style>
        <Style Selector="Border.capline">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource VLine}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.key">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource VText2}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource VHint}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource VMuted}" />
        </Style>
        <Style Selector="TextBlock.good">
            <Setter Property="Foreground" Value="{StaticResource VGood}" />
        </Style>
        <Style Selector="TextBlock.bad">
            <Setter Property="Foreground" Value="{StaticResource VBad}" />
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="{StaticResource VWarn}" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource VMono}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="TextBlock.strong">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>

        <!-- a setting's row: the label (and its hint) left, the control right, a faint line under it -->
        <Style Selector="Border.row">
            <Setter Property="BorderBrush" Value="{StaticResource VRowLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
        <!-- a small outlined tag (the version, "✓ checked") -->
        <Style Selector="Border.tag">
            <Setter Property="BorderBrush" Value="{StaticResource VAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tag TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource VAccent}" />
        </Style>
        <Style Selector="Border.tag.good">
            <Setter Property="BorderBrush" Value="{StaticResource VGood}" />
        </Style>
        <Style Selector="Border.tag.good TextBlock">
            <Setter Property="Foreground" Value="{StaticResource VGood}" />
        </Style>
        <!-- the status at the right of the header: a dot and a few words -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource VGood}" />
        </Style>
        <Style Selector="Ellipse.dot.warn"><Setter Property="Fill" Value="{StaticResource VWarn}" /></Style>
        <Style Selector="Ellipse.dot.bad"><Setter Property="Fill" Value="{StaticResource VBad}" /></Style>

        <!-- the menu bar -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="{StaticResource VChrome}" />
            <Setter Property="Height" Value="32" />
        </Style>

        <!-- the page list -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource VText2}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.nav.sub">
            <Setter Property="Padding" Value="28,0,14,0" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{StaticResource VAccentDim}" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VPanel2}" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VAccentDim}" />
        </Style>
        <!-- the setup's steps, in the page list's place -->
        <Style Selector="Border.step">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.step.now">
            <Setter Property="Background" Value="{StaticResource VAccentDim}" />
        </Style>

        <!-- buttons: grey (Button.outline) and the main one (Button.accent / Button.play) -->
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="{StaticResource VPanel2}" />
            <Setter Property="BorderBrush" Value="{StaticResource VLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.accent, Button.play">
            <Setter Property="Background" Value="{StaticResource VAccent}" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#6aacff" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.play:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VPanel2}" />
            <Setter Property="Foreground" Value="{StaticResource VDisabled}" />
        </Style>

        <!-- a choice of a few: a ListBox laid out in a row, the chosen one filled -->
        <Style Selector="ListBox.seg">
            <Setter Property="Background" Value="{StaticResource VNav}" />
            <Setter Property="BorderBrush" Value="{StaticResource VLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="0" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.seg ListBoxItem">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource VText2}" />
        </Style>
        <Style Selector="ListBox.seg ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ListBox.seg ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VAccentDim}" />
            <Setter Property="Foreground" Value="#ffffff" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.seg ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33598c" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="ListBox.seg ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource VAccentDim}" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
        <Style Selector="ListBox.seg ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource VDisabled}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource VNav}" />
            <Setter Property="BorderBrush" Value="{StaticResource VLine}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource VAccent}" />
            <Setter Property="Background" Value="{StaticResource VPanel2}" />
            <Setter Property="MinHeight" Value="8" />
        </Style>
        <Style Selector="ProgressBar.done"><Setter Property="Foreground" Value="{StaticResource VGood}" /></Style>
        <!-- the build's list of steps: the one running has a fill -->
        <Style Selector="Border.steprow">
            <Setter Property="BorderBrush" Value="{StaticResource VRowLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.steprow.now"><Setter Property="Background" Value="{StaticResource VPanel}" /></Style>
    </Application.Styles>
</Application>
